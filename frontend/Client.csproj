<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../dotnet/wwwroot/app.css" Link="wwwroot/app.css" />
    <Content Include="../dotnet/wwwroot/download.js" Link="wwwroot/download.js" />
    <Content Include="../dotnet/wwwroot/logo.webp" Link="wwwroot/logo.webp" />
  </ItemGroup>

</Project>
